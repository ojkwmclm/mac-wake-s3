menu "Mac Wake S3"
    config WAKE_WIFI_SSID
        string "2.4 GHz Wi-Fi SSID (empty = button only)"
        default ""
    config WAKE_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
    config WAKE_BLINKER_KEY
        string "Blinker independent-device Auth Key (empty disables cloud)"
        default ""
    config WAKE_SEND_SHIFT
        bool "Send a Shift press/release after resume or when USB is active"
        default n
        help
            Optional fallback. Default only sends USB remote resume.
            Enable only after testing; this can affect a foreground application.
    config WAKE_HEALTH_RESET
        bool "EXPERIMENTAL: watchdog for stopped USB/button workers"
        depends on ESP_TASK_WDT_EN && ESP_TASK_WDT_INIT && ESP_TASK_WDT_PANIC
        default n
        help
            Uses an IDF TWDT user; cloud offline never stops feeding.
            Default disabled until controlled reset validation passes.
    config WAKE_HEALTH_RESET_TEST
        bool "TEST ONLY: one-shot persistent 180s USB worker stop"
        depends on WAKE_HEALTH_RESET
        default n
        help
            Commits an NVS one-shot marker before stopping the USB worker.
            A reset must not re-arm this test. Dedicated local test image only.
    config WAKE_HEALTH_FAULT_TEST
        bool "TEST ONLY: pause USB worker 60s once after 60s uptime"
        depends on !WAKE_HEALTH_RESET_TEST
        default n
        help
            Dedicated diagnostic image. Keeps yielding CPU, allowing cloud and
            supervisor to run. Sleep/wake requests pause for up to one minute.
            Automatically recovers. Never enable for unattended normal use.
endmenu
